MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ai_final_disaster

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP settings for sending resource request emails. Use an app password/token where required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_DELIVERY_MODE=demo

# Comma-separated frontend origins.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

